<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Activity shell theme (window + status bar).
      The actual content is rendered by Jetpack Compose (KaiaMeshTheme),
      so this style only needs to inherit AppCompat / NoActionBar.
    -->
    <style name="Theme.MeshVPN" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0B0F14</item>
        <item name="android:navigationBarColor">#0B0F14</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
