<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Thème de la coquille d'activité (fenêtre + barre d'état).
      Le contenu réel est rendu par Jetpack Compose (KaiaMeshTheme) :
      ce style n'a donc besoin que d'hériter d'AppCompat / NoActionBar.
    -->
    <style name="Theme.MeshVPN" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0B0F14</item>
        <item name="android:navigationBarColor">#0B0F14</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
