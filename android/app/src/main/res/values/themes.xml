<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Activity shell theme (window + status bar).
      The real content is rendered by Jetpack Compose (KaiaMeshTheme):
      this style therefore only needs to inherit from AppCompat / NoActionBar.
    -->
    <style name="Theme.MeshVPN" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0B0F14</item>
        <item name="android:navigationBarColor">#0B0F14</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
